{
  "name": "contentops-conf",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "typegen": "pnpm --filter @repo/studio exec sanity schema extract --enforce-required-fields && pnpm --filter @repo/studio exec sanity typegen generate",
    "predev": "tsx scripts/check-next-version.ts",
    "clean": "rm -rf .turbo node_modules/.cache apps/*/.next apps/*/.turbo apps/*/dist packages/*/.turbo packages/*/dist",
    "blueprints:plan": "pnpm dlx sanity@latest blueprints plan",
    "blueprints:deploy": "pnpm dlx sanity@latest blueprints deploy",
    "blueprints:info": "pnpm dlx sanity@latest blueprints info",
    "blueprints:logs": "pnpm dlx sanity@latest blueprints logs --watch"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.23.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
